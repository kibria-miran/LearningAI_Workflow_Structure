DEEPSEEK_API_KEY=your_key_here
# Shared secret callers (n8n) must send as header X-API-Key. Leave empty ONLY for local tests.
APP_API_KEY=change-me
# Comma-separated browser origins allowed to call the API. Empty = no CORS.
ALLOWED_ORIGINS=
# Read by tracker.py (Stage A: make tracker use these instead of constants)
API_BUDGET_MONTHLY=10.00
API_DAILY_ALERT=1.00
